# Written by `npx convex dev` on first run.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# --- Vercel AI Gateway ------------------------------------------------------
# One key for every model: DeepSeek for chat, OpenAI's embedding model for
# retrieval, Whisper for voice notes. Get it from the Vercel dashboard under
# AI Gateway -> API keys.
#
# Convex actions cannot read this file, and every model call happens inside one,
# so the key must ALSO be set on the deployment:
#   npx convex env set AI_GATEWAY_API_KEY <key>
# The copy here is only for scripts that run on your machine.
AI_GATEWAY_API_KEY=

# --- Platform administrator -------------------------------------------------
# The account that can see and manage every workspace. Apply these with
#   npm run provision:admin
# which creates the admin, or resets the password and revokes its sessions if
# it already exists. `-- --generate` writes a fresh strong password for you.
#
# Minimum 16 characters. This is a plaintext credential at rest: the deployment
# only ever stores a PBKDF2-SHA256 hash, so this file is the one place the
# password exists in the clear. Treat it accordingly.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Platform administrator
ADMIN_PASSWORD=

# --- Convex-side secrets (NOT read from this file) ---------------------------
# These live on the deployment, set with `npx convex env set <KEY> <value>`:
#   JWT_PRIVATE_KEY   base64 RS256 private key, for signing access tokens
#   JWT_PUBLIC_JWK    matching public JWK, served at /.well-known/jwks.json
#   OPENAI_API_KEY    the same key as above; Convex actions cannot read .env.local
